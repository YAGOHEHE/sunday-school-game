{
  "games": [
    {
      "id": "emoji-biblico",
      "icon": "😀",
      "title": {
        "es": "Emoji bíblico",
        "zh": "圣经表情猜猜猜"
      },
      "category": "biblia",
      "minMinutes": 5,
      "maxMinutes": 10,
      "objective": {
        "es": "Adivinar personajes y escenas de la Biblia descritos solo con emoticonos.",
        "zh": "只靠一串表情符号，猜出圣经里的人物和场景。"
      },
      "steps": [
        {
          "es": "El profe muestra o lee una tarjeta de emojis sin decir la respuesta.",
          "zh": "老师出示或念出一张表情卡，不说出答案。"
        },
        {
          "es": "Los jugadores (o equipos) levantan la mano para adivinar el personaje o la escena.",
          "zh": "玩家（或各组）举手抢答，猜出那是哪个人物或场景。"
        },
        {
          "es": "Quien acierta gana un punto; después se pulsa «Revelar» para ver la respuesta.",
          "zh": "答对的得一分；然后按“揭晓”看答案。"
        },
        {
          "es": "Si nadie acierta, el profe da una pista o pasa a la siguiente tarjeta.",
          "zh": "若无人答对，老师给个提示或换下一张。"
        }
      ],
      "tips": [
        {
          "es": "👉 Puedes dividir a la clase en dos equipos y llevar la cuenta de puntos.",
          "zh": "👉 可以把全班分成两组，记分比赛。"
        },
        {
          "es": "👉 Deja que los mayores creen sus propias tarjetas de emojis para los demás.",
          "zh": "👉 让大一点的孩子自己设计表情卡考大家。"
        },
        {
          "es": "Adaptación: si un emoji no se ve igual en todos los móviles, descríbelo en voz alta.",
          "zh": "适应课堂：若某个表情在不同手机显示不一样，就口头描述一下。"
        }
      ],
      "why": {
        "es": "Repasar la Biblia de forma visual ayuda a recordar las historias y a quienes les cuesta leer.",
        "zh": "用图像复习圣经，能帮助记住故事，也照顾不擅长阅读的人。"
      },
