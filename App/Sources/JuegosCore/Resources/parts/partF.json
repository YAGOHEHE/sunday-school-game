    {
      "id": "mapa-biblico",
      "icon": "🗺️",
      "title": {
        "es": "Mapa bíblico",
        "zh": "圣经地图"
      },
      "category": "biblia",
      "minMinutes": 5,
      "maxMinutes": 10,
      "objective": {
        "es": "Situar en el mapa las ciudades y lugares de la Biblia; gana quien ponga el punto más cerca.",
        "zh": "在地图上找出圣经里的城市和地点；点得最近的人获胜。"
      },
      "steps": [
        {
          "es": "En la lámina aparece un lugar: «Coloca este lugar».",
          "zh": "图上会出现一个地点：“找出这个地点”。"
        },
        {
          "es": "Dos jugadores por ronda. El Jugador 1 toca el mapa donde cree que está; luego el Jugador 2.",
          "zh": "每轮两位玩家。玩家1点一下自己认为的位置，接着玩家2。"
        },
        {
          "es": "Pulsa «Revelar»: una estrella muestra el sitio real y marca quién quedó más cerca.",
          "zh": "点“揭晓”：星星显示真实位置，并标出谁离得最近。"
        },
        {
          "es": "El punto más cercano gana; en caso de empate ganan los dos.",
          "zh": "最近的人得分；平手则两人都得分。"
        },
        {
          "es": "Pulsa «Siguiente lugar» y rota de jugadores.",
          "zh": "点“下一个”，并轮换玩家。"
        }
      ],
      "tips": [
        {
          "es": "👉 Empieza por los lugares conocidos (Jerusalén, Belén, mar de Galilea) y sube la dificultad.",
          "zh": "👉 先从熟悉的地点开始（耶路撒冷、伯利恒、加利利海），再逐渐加难。"
        },
        {
          "es": "👉 Al revelar, lee la pista para explicar un poco de historia de cada lugar.",
          "zh": "👉 揭晓后，读一读说明，讲讲每个地点的故事。"
        },
        {
          "es": "👉 Egipto, Babilonia, Nínive y Ur quedan fuera de la lámina: se señalan hacia su borde.",
          "zh": "👉 埃及、巴比伦、尼尼微和吾珥在图外：指向对应的边缘即可。"
        }
      ],
      "why": {
        "es": "Ubicar los lugares ayuda a entender los viajes y las historias de la Biblia en su geografía real.",
        "zh": "知道地点在哪里，有助于理解圣经中的旅程和故事的真实地理背景。"
      },
      "tools": [
        {
          "kind": "map",
          "title": {
            "es": "Lugares",
            "zh": "地点"
          },
          "groups": [
